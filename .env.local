# Local Docker broker profile - the FALLBACK path.
#
# Kept working deliberately. Solace Cloud is now the primary broker, but the
# 2026-08-14 decision chose local specifically to avoid a network dependency
# during a live session. This file is what makes reverting a one-flag operation:
#   .\demo-up.ps1 -Local
#
# No secrets here: these are the credentials the container is created with in
# demo-up.ps1, so this file IS committed.

SOLACE_HOST=tcp://localhost:55555
SOLACE_VPN=default
SOLACE_USER=default
SOLACE_PASSWORD=default

SOLACE_SEMP=http://localhost:8080/SEMP/v2/config
SOLACE_ADMIN_USER=admin
SOLACE_ADMIN_PASSWORD=admin
